{
  "openapi": "3.1.0",
  "info": {
    "title": "Research Engine",
    "description": "Automated land-survey research: parcel, deed, plat, flood, control. Production-ready.",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/research/jobs": {
      "post": {
        "tags": [
          "research"
        ],
        "summary": "Create a research job",
        "description": "Starts auto-fetching documents for an order. Accepts a list of document types (from the source registry). Returns the created job with per-document status. Rate-limited per tenant.",
        "operationId": "create_research_job_api_v1_research_jobs_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Idempotency-Key"
            }
          },
          {
            "name": "X-Actor-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Actor-Id"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResearchJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataEnvelope_ResearchJob_"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Invalid document types",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/research/jobs/{job_id}": {
      "get": {
        "tags": [
          "research"
        ],
        "summary": "Get research job status",
        "description": "Returns the job metadata and per-document progress. Poll this endpoint to track job completion.",
        "operationId": "get_research_job_api_v1_research_jobs__job_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          },
          {
            "name": "X-Actor-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Actor-Id"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataEnvelope_ResearchJob_"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/research/jobs/{job_id}/retry": {
      "post": {
        "tags": [
          "research"
        ],
        "summary": "Retry failed documents",
        "description": "Creates a new research job with the failed document types from the original job. The original job is not mutated.",
        "operationId": "retry_research_job_api_v1_research_jobs__job_id__retry_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          },
          {
            "name": "X-Actor-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Actor-Id"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RetryResearchJobRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataEnvelope_ResearchJob_"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Job not retryable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/research/jobs/{job_id}/cancel": {
      "post": {
        "tags": [
          "research"
        ],
        "summary": "Cancel a research job",
        "description": "Cancels a running/queued job. In-flight documents complete their current step; queued documents are skipped.",
        "operationId": "cancel_research_job_api_v1_research_jobs__job_id__cancel_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          },
          {
            "name": "X-Actor-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Actor-Id"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CancelJobRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataEnvelope_ResearchJob_"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Job not cancellable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/research/orders/{order_id}/jobs": {
      "get": {
        "tags": [
          "research"
        ],
        "summary": "List research jobs for an order",
        "description": "Returns a compact listing of research jobs for the given order, newest first. Use GET /jobs/{id} for a job's per-document detail.",
        "operationId": "list_order_jobs_api_v1_research_orders__order_id__jobs_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Order Id"
            }
          },
          {
            "name": "X-Actor-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Actor-Id"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataEnvelope_list_ResearchJobSummary__"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Liveness + dependency probes",
        "description": "Return 200 only if the process is up and its dependencies are reachable.\n\nProbes Postgres (SELECT 1) and Redis (PING). A 503 means the app is running\nbut cannot process jobs \u2014 signal for the orchestrator to stop routing traffic.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/health/live": {
      "get": {
        "summary": "Liveness only",
        "description": "Cheap liveness \u2014 the process is up (does not probe dependencies).",
        "operationId": "liveness_api_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelJobRequest": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Optional cancellation reason (for audit trail)."
          }
        },
        "type": "object",
        "title": "CancelJobRequest",
        "description": "Request to cancel a running/queued job.\n\nIn-flight documents complete their current step; queued documents are skipped.\nThe job transitions to ``cancelled``."
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "none"
        ],
        "title": "Confidence",
        "description": "How sure the engine is that the result actually pertains to the searched property."
      },
      "CreateResearchJobRequest": {
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid",
            "title": "Order Id",
            "description": "Order to research"
          },
          "document_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Document Types",
            "description": "Document types to fetch, e.g. ['PARCEL_RECORD', 'FLOOD']. Empty = fetch all applicable types for the order's survey type."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key",
            "description": "Client-generated idempotency key. Auto-generated if not provided."
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url",
            "description": "Optional HTTPS URL to POST a job summary to when the job reaches a terminal state. Delivered at-least-once with retry + backoff; delivery failures are logged, never fatal to the job."
          }
        },
        "type": "object",
        "required": [
          "order_id"
        ],
        "title": "CreateResearchJobRequest",
        "description": "Request to start a research job for an order.\n\n``document_types`` is the list of document types to fetch (from the\nsource registry). If empty, all applicable types are fetched.\n\n``idempotency_key`` is optional; if omitted, the server generates one.\nDuplicate requests with the same key return the existing job."
      },
      "DataEnvelope_ResearchJob_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ResearchJob"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "DataEnvelope[ResearchJob]"
      },
      "DataEnvelope_list_ResearchJobSummary__": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/ResearchJobSummary"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "DataEnvelope[list[ResearchJobSummary]]"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ResearchErrorCode",
            "description": "Machine-readable error code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable error message"
          },
          "details": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details",
            "description": "Additional context (e.g. which doc_type failed, validation errors)"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "description": "Structured error response: ``{ error: { code, message, details? } }``."
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "description": "Error envelope: ``{ error: ErrorDetail }``."
      },
      "FileReference": {
        "properties": {
          "file_id": {
            "type": "string",
            "format": "uuid",
            "title": "File Id",
            "description": "Evidence module File.id"
          },
          "order_file_id": {
            "type": "string",
            "format": "uuid",
            "title": "Order File Id",
            "description": "OrderFile.id linking this file to the order"
          },
          "key": {
            "type": "string",
            "title": "Key",
            "description": "S3 object key: tenants/{tenant}/orders/{order}/research/{file_id}/{name}"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "Original filename"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes",
            "description": "File size in bytes"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256",
            "description": "SHA-256 digest of the file",
            "default": ""
          },
          "mime_type": {
            "type": "string",
            "title": "Mime Type",
            "description": "MIME type",
            "default": "application/pdf"
          }
        },
        "type": "object",
        "required": [
          "file_id",
          "order_file_id",
          "key",
          "filename",
          "size_bytes"
        ],
        "title": "FileReference",
        "description": "Reference to a file stored in S3 via the evidence module."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProvenanceRecord": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id",
            "description": "Unique source identifier, e.g. 'parcel.state_fl', 'fema.nfhl'"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "How the data was obtained: arcgis-rest, census, playwright, etc.",
            "default": ""
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Source URL or endpoint hit",
            "default": ""
          },
          "retrieved_utc": {
            "type": "string",
            "title": "Retrieved Utc",
            "description": "ISO-8601 timestamp of the retrieval",
            "default": ""
          },
          "attempt": {
            "type": "integer",
            "title": "Attempt",
            "description": "Which attempt succeeded (1-based)",
            "default": 1
          },
          "fallback_chain": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fallback Chain",
            "description": "Ordered list of source_ids tried before success"
          },
          "file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File",
            "description": "Relative path of saved artifact within the job folder"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256",
            "description": "SHA-256 digest of the saved artifact (if any)"
          }
        },
        "type": "object",
        "required": [
          "source_id"
        ],
        "title": "ProvenanceRecord",
        "description": "Where this piece of data came from \u2014 stamped by the engine, not by adapters."
      },
      "ResearchDocStatus": {
        "type": "string",
        "enum": [
          "queued",
          "fetching",
          "fetched",
          "uploading",
          "uploaded",
          "failed",
          "skipped"
        ],
        "title": "ResearchDocStatus",
        "description": "Per-document progress \u2014 tracked in ``research_documents.status``.\n\nTransitions:\n  queued    \u2192 fetching        (worker starts this document)\n  fetching  \u2192 fetched         (orchestrator returned data)\n  fetching  \u2192 failed          (adapter error after retries)\n  fetched   \u2192 uploading       (S3 upload started)\n  uploading \u2192 uploaded        (S3 upload complete + OrderFile created)\n  uploading \u2192 failed          (S3 upload error)\n  queued    \u2192 skipped         (doc type not applicable to this order)"
      },
      "ResearchDocument": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "research_documents.id"
          },
          "doc_type": {
            "type": "string",
            "title": "Doc Type",
            "description": "Document type, e.g. 'PARCEL_RECORD'"
          },
          "status": {
            "$ref": "#/components/schemas/ResearchDocStatus",
            "description": "Current status of this document"
          },
          "source_outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceOutcome"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the source returned what it did (after fetch completes)"
          },
          "confidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Confidence"
              },
              {
                "type": "null"
              }
            ],
            "description": "How sure the engine is that this pertains to the property"
          },
          "file": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FileReference"
              },
              {
                "type": "null"
              }
            ],
            "description": "File reference (set after S3 upload completes)"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "One-line summary of what was found",
            "default": ""
          },
          "link": {
            "type": "string",
            "title": "Link",
            "description": "Fallback deep-link when auto-fetch is not available",
            "default": ""
          },
          "link_label": {
            "type": "string",
            "title": "Link Label",
            "description": "Display text for the link button",
            "default": ""
          },
          "provenance": {
            "items": {
              "$ref": "#/components/schemas/ProvenanceRecord"
            },
            "type": "array",
            "title": "Provenance",
            "description": "Audit trail: every source hit that contributed to this document"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "Per-document warnings (e.g. 'buffered match, verify location')"
          },
          "error_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResearchErrorCode"
              },
              {
                "type": "null"
              }
            ],
            "description": "Structured error code when status == 'failed'"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message",
