# Copy to .env and adjust. NEVER commit real secrets.
RUN_ENV=local

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/researchhub

# S3
AWS_REGION=us-east-1
AWS_S3_REGION_NAME=us-east-1
S3_ARTIFACTS_BUCKET=researchhub-artifacts

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ORIGINS=http://localhost:3000

# --- Production auth (Cognito JWT). Leave unset for dev header mode. ---------
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<pool_id>
# COGNITO_AUDIENCE=<client_id>
# COGNITO_CLIENT_SECRET=

# --- Rate limiting (per tenant, applied to POST /jobs) -----------------------
# RATE_LIMIT_RESEARCH=20/minute

# --- Database connection pool (production) ------------------------------------
# POOL_SIZE=10
# MAX_OVERFLOW=20
# POOL_TIMEOUT=30
# POOL_RECYCLE=1800

# --- Worker reliability --------------------------------------------------------
# REAPER_STALE_QUEUED_MINUTES=10
# REAPER_STALE_RUNNING_MINUTES=30
# JOB_HARD_TIME_LIMIT=300
# JOB_SOFT_TIME_LIMIT=240

# Research defaults
MAX_RETRIES_PER_DOCUMENT=3
DOCUMENT_TIMEOUT_SECONDS=60