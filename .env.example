# Copy to .env and adjust. NEVER commit real secrets.
RUN_ENV=local

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/researchhub

# S3
AWS_REGION=us-east-1
AWS_S3_REGION_NAME=us-east-1
S3_ARTIFACTS_BUCKET=researchhub-artifacts

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ORIGINS=http://localhost:3000

# Research defaults
MAX_RETRIES_PER_DOCUMENT=3
DOCUMENT_TIMEOUT_SECONDS=60